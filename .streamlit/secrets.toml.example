# Salin menjadi .streamlit/secrets.toml (jangan di-commit) atau isi di Streamlit Cloud > Settings > Secrets.
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
# Alamat publik aplikasi, tanpa garis miring di akhir. Harus sama dengan Authorized redirect URI di Google.
APP_URL = "http://localhost:8501"
# String acak panjang (minimal 32 karakter). Jangan diubah setelah dipakai, karena token tersimpan terenkripsi dengannya.
TOKEN_ENCRYPTION_KEY = ""
# SQLite untuk lokal. Untuk hosting gratis pakai Postgres (mis. Supabase/Neon): postgresql://user:pass@host:5432/db
DATABASE_URL = "sqlite:///data/penggabung.db"
# Opsional: batasi siapa yang boleh masuk, pisahkan dengan koma.
ALLOWED_EMAILS = ""
# Opsional: batas ukuran unduhan lewat aplikasi (MB).
MAX_DOWNLOAD_MB = "200"

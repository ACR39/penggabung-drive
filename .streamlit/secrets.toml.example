# Salin menjadi .streamlit/secrets.toml (jangan di-commit) atau isi di Streamlit Cloud > Settings > Secrets.
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
# Alamat publik aplikasi, tanpa garis miring di akhir. Harus sama dengan Authorized redirect URI di Google.
APP_URL = "http://localhost:8501"
# String acak panjang (minimal 32 karakter). Jangan diubah setelah dipakai, karena token tersimpan terenkripsi dengannya.
TOKEN_ENCRYPTION_KEY = ""
# SQLite untuk lokal. Untuk hosting pakai Postgres. Supabase: pakai alamat *Session pooler* (host ...pooler.supabase.com, port 5432):
# postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL = "sqlite:///data/penggabung.db"
# Opsional: batasi siapa yang boleh masuk, pisahkan dengan koma.
ALLOWED_EMAILS = ""
# Opsional: batas ukuran unduhan lewat aplikasi (MB).
MAX_DOWNLOAD_MB = "200"
# Opsional: "1" menampilkan waktu dan jumlah kueri tiap halaman di sidebar (untuk mencari bagian yang lambat).
DEBUG = ""

# Opsional: Yandex Disk (daftarkan aplikasi di https://oauth.yandex.com, izin cloud_api:disk.app_folder,
# login:info, login:email; Redirect URI sama dengan APP_URL)
# YANDEX_CLIENT_ID = ""
# YANDEX_CLIENT_SECRET = ""
